# Settings for docker-compose.x2mimic.yaml (X2 demo collection + Isaac Mimic).

###
# Isaac Sim / Isaac Lab
###
ACCEPT_EULA=Y
ISAACSIM_BASE_IMAGE=nvcr.io/nvidia/isaac-sim
ISAACSIM_VERSION=5.1.0
DOCKER_ISAACSIM_ROOT_PATH=/isaac-sim
DOCKER_ISAACLAB_PATH=/workspace/isaaclab
DOCKER_USER_HOME=/root
DOCKER_NAME_SUFFIX=""

# pickplace_x2_env_cfg.py resolves the merged X2+OmniHand URDF, its mesh root and
# the RoboTwin can/tray USDs through this absolute prefix. The image symlinks it to
# the Isaac Lab checkout, so leave it matching the configs.
HOST_REPO_PATH=/home/wagner/code/IsaacLab

# Where recordings and generated datasets land on the host. Kept out of the image
# (datasets/ is in .dockerignore) so a 20 GB history is not baked into a layer.
DATASET_HOST_DIR=../datasets

###
# CloudXR runtime
###
CLOUDXR_IMAGE=cloudxr-hybrid:5d-6l
# Profiles the 5.0.1 daemon actually implements: auto-webrtc, quest3, apple-vision-pro.
# pico4 and pico4u are present only as strings in the overlaid 6.0.5 libs and make
# the daemon exit 0 at startup -- do not set them with this hybrid image.
NV_DEVICE_PROFILE=quest3
NV_CXR_STREAMSDK_ENABLE_ICE=1

###
# WebXR front end
###
WEBXR_PORT=8443
# mkcert leaf covering the address the headset connects to. Reissue when this
# machine's IP changes, or the headset rejects the origin and WebXR refuses to run:
#   cd webxr_certs && mkcert <host-ip> localhost 127.0.0.1
TLS_CERT=172.18.33.98+2.pem
TLS_KEY=172.18.33.98+2-key.pem
# Where the CloudXR signaling endpoint listens. auto-webrtc moves it 48010 -> 49100.
CLOUDXR_SIGNALING=127.0.0.1:49100
# Origin allowed to reach signaling cross-origin, for the NVIDIA-hosted client.
HOSTED_CLIENT_ORIGIN=https://nvidia.github.io

###
# GPU pinning
###
# Isaac Sim deadlocks on a multi-GPU render graph when a second card is busy, so
# the container is given exactly one GPU. Index as the host numbers them.
ISAAC_GPU=1
